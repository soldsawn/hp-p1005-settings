<?xml version="1.0" encoding="utf-8"?>
<!-- This repository's packages (only the test project has any) all come from nuget.org,
     whatever a machine-wide NuGet.Config maps elsewhere. -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <clear />
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
